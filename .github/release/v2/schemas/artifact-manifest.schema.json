{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/artifact-manifest.schema.json",
  "title": "UCM offline content-addressed artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "kind", "lifecycle_plan_sha256", "mode", "schema_version", "sha256", "source_sha", "stage", "validation", "version"],
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "wheel"}}, "required": ["kind"]}, "minContains": 3, "maxContains": 3},
        {"contains": {"properties": {"kind": {"const": "image"}}, "required": ["kind"]}, "minContains": 3, "maxContains": 3},
        {"contains": {"properties": {"kind": {"const": "chart"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "kind": {"const": "artifact-manifest"},
    "lifecycle_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"const": "dry-run"},
    "schema_version": {"const": 2},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage": {"enum": ["pr", "develop", "nightly", "draft", "rc", "stable", "hotfix"]},
    "validation": {"$ref": "#/$defs/validation"},
    "version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact": {
      "oneOf": [
        {"$ref": "#/$defs/file_artifact"},
        {"$ref": "#/$defs/oci_artifact"}
      ]
    },
    "file_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "kind", "name", "path", "sha256", "size", "version"],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "kind": {"enum": ["wheel", "chart"]},
        "name": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {"pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"},
            {"not": {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}}
          ]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "oci_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "digest", "kind", "name", "platforms", "version"],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "kind": {"const": "image"},
        "name": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/oci_platform"},
          "allOf": [
            {"contains": {"properties": {"platform": {"const": "linux/amd64"}}, "required": ["platform"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"platform": {"const": "linux/arm64"}}, "required": ["platform"]}, "minContains": 1, "maxContains": 1}
          ]
        },
        "version": {"type": "string", "minLength": 1}
      }
    },
    "oci_platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "platform"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "platform": {"enum": ["linux/amd64", "linux/arm64"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_bytes", "lifecycle_plan", "oci_identity", "product_closure", "registry_readback", "runtime"],
      "properties": {
        "file_bytes": {"const": "passed"},
        "lifecycle_plan": {"const": "passed"},
        "oci_identity": {"const": "passed"},
        "product_closure": {"const": "passed"},
        "registry_readback": {"const": "unexecuted"},
        "runtime": {"const": "unexecuted"}
      }
    }
  }
}
