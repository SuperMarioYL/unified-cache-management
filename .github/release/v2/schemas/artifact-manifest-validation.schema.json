{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/artifact-manifest-validation.schema.json",
  "title": "UCM artifact manifest validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "lifecycle_plan_sha256", "manifest_sha256", "mode", "schema_version", "source_sha", "stage", "status", "validation", "version"],
  "properties": {
    "kind": {"const": "artifact-manifest-validation"},
    "lifecycle_plan_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"const": "dry-run"},
    "schema_version": {"const": 2},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage": {"enum": ["pr", "develop", "nightly", "draft", "rc", "stable", "hotfix"]},
    "status": {"const": "passed"},
    "validation": {"$ref": "#/$defs/validation"},
    "version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_bytes", "lifecycle_plan", "oci_identity", "product_closure", "registry_readback", "runtime"],
      "properties": {
        "file_bytes": {"const": "passed"},
        "lifecycle_plan": {"const": "passed"},
        "oci_identity": {"const": "passed"},
        "product_closure": {"const": "passed"},
        "registry_readback": {"const": "unexecuted"},
        "runtime": {"const": "unexecuted"}
      }
    }
  }
}
