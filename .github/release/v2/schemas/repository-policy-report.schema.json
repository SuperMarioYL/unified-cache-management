{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucm.example.invalid/schemas/repository-policy-report.schema.json",
  "title": "UCM repository policy report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks", "compliant", "expected_repository", "kind", "mode", "observed_repository", "repository_role", "schema_version"],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/check"}
    },
    "compliant": {"type": "boolean"},
    "expected_repository": {"$ref": "#/$defs/repository"},
    "kind": {"const": "repository-policy-report"},
    "mode": {"const": "read-only"},
    "observed_repository": {"$ref": "#/$defs/repository"},
    "repository_role": {"enum": ["validation", "production"]},
    "schema_version": {"const": 2}
  },
  "allOf": [
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "branch.develop.exists"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "branch.develop.protected"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "branch.main.exists"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "branch.main.protected"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "default-branch.main"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "environment.release-production.branch-policy"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "environment.release-production.exists"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "environment.release-production.reviewers"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "repository.coordinate"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "ruleset.release-tags.active-pattern"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "workflows.expected-set"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "workflows.permissions.read-only"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}}},
    {
      "if": {"properties": {"compliant": {"const": true}}, "required": ["compliant"]},
      "then": {"properties": {"checks": {"not": {"contains": {"type": "object", "properties": {"status": {"const": "gap"}}, "required": ["status"]}}}}},
      "else": {"properties": {"checks": {"contains": {"type": "object", "properties": {"status": {"const": "gap"}}, "required": ["status"]}, "minContains": 1}}}
    }
  ],
  "$defs": {
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "id", "status"],
      "properties": {
        "evidence": {"type": "string", "minLength": 1},
        "id": {"enum": ["branch.develop.exists", "branch.develop.protected", "branch.main.exists", "branch.main.protected", "default-branch.main", "environment.release-production.branch-policy", "environment.release-production.exists", "environment.release-production.reviewers", "repository.coordinate", "ruleset.release-tags.active-pattern", "workflows.expected-set", "workflows.permissions.read-only"]},
        "status": {"enum": ["gap", "passed"]}
      }
    }
  }
}
