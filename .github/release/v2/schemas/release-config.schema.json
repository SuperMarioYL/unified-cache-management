{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/release-config.schema.json",
  "title": "UCM release lifecycle configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["branches", "environments", "kind", "mode", "products", "repositories", "repository_policy", "retention_days", "schema_version", "version"],
  "properties": {
    "branches": {"type": "object", "additionalProperties": false, "required": ["develop", "main"], "properties": {"develop": {"const": "develop"}, "main": {"const": "main"}}},
    "environments": {"type": "object", "additionalProperties": false, "required": ["blue", "yellow"], "properties": {"blue": {"$ref": "#/$defs/environment"}, "yellow": {"$ref": "#/$defs/environment"}}},
    "kind": {"const": "ucm-release-lifecycle-config"},
    "mode": {"const": "dry-run"},
    "products": {"$ref": "#/$defs/products"},
    "repositories": {"type": "object", "additionalProperties": false, "required": ["production", "validation"], "properties": {"production": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}, "validation": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}}},
    "repository_policy": {"$ref": "#/$defs/repository_policy"},
    "retention_days": {"type": "object", "additionalProperties": false, "required": ["develop", "draft", "hotfix", "nightly", "pr", "rc", "stable"], "properties": {"develop": {"const": 14}, "draft": {"const": 30}, "hotfix": {"const": null}, "nightly": {"const": 14}, "pr": {"const": 7}, "rc": {"const": null}, "stable": {"const": null}}},
    "schema_version": {"const": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "$defs": {
    "environment": {"type": "object", "additionalProperties": false, "required": ["evidence_level"], "properties": {"evidence_level": {"const": "simulated"}}},
    "wheel": {"type": "object", "additionalProperties": false, "required": ["backend", "distribution", "import_name"], "properties": {"backend": {"enum": ["cuda", "cann-a2", "cann-a3"]}, "distribution": {"enum": ["uc-manager-cuda", "uc-manager-cann-a2", "uc-manager-cann-a3"]}, "import_name": {"const": "ucm"}}},
    "image": {"type": "object", "additionalProperties": false, "required": ["family", "platforms", "repository"], "properties": {"family": {"enum": ["cuda", "cann-a2", "cann-a3"]}, "platforms": {"const": ["linux/amd64", "linux/arm64"]}, "repository": {"type": "string", "pattern": "^ghcr\\.io/\\{repository\\}/[a-z0-9-]+$"}}},
    "chart": {"type": "object", "additionalProperties": false, "required": ["name", "source"], "properties": {"name": {"const": "unified-cache-pd"}, "source": {"const": "charts/ucm"}}},
    "products": {"type": "object", "additionalProperties": false, "required": ["chart", "images", "wheels"], "properties": {"chart": {"$ref": "#/$defs/chart"}, "images": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/image"}}, "wheels": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/wheel"}}}},
    "deployment_branch_policy": {"type": "object", "additionalProperties": false, "required": ["custom_branch_policies", "protected_branches"], "properties": {"custom_branch_policies": {"const": false}, "protected_branches": {"const": true}}},
    "production_environment": {"type": "object", "additionalProperties": false, "required": ["deployment_branch_policy", "minimum_required_reviewers", "name"], "properties": {"deployment_branch_policy": {"$ref": "#/$defs/deployment_branch_policy"}, "minimum_required_reviewers": {"type": "integer", "minimum": 1}, "name": {"const": "release-production"}}},
    "repository_policy": {"type": "object", "additionalProperties": false, "required": ["default_branch", "dry_run_workflows", "production_environment", "protected_branches", "tag_pattern"], "properties": {"default_branch": {"const": "main"}, "dry_run_workflows": {"const": ["develop-release-dry-run.yml", "draft-environment-dry-run.yml", "nightly-release-dry-run.yml", "pr-release-dry-run.yml", "release-cleanup-dry-run.yml", "release-control-dry-run.yml", "release-lifecycle-dry-run.yml", "repository-policy-audit-dry-run.yml"]}, "production_environment": {"$ref": "#/$defs/production_environment"}, "protected_branches": {"const": ["develop", "main"]}, "tag_pattern": {"const": "v[0-9]*"}}}
  }
}
