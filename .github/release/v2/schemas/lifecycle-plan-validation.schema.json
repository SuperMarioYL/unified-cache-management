{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/lifecycle-plan-validation.schema.json",
  "title": "UCM lifecycle plan validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "mode", "plan_sha256", "schema_version", "semantic_gates", "source_sha", "stage", "status"],
  "properties": {
    "kind": {"const": "lifecycle-plan-validation"},
    "mode": {"const": "dry-run"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"const": 2},
    "semantic_gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"const": "canonical-self-digest"}, "status": {"const": "passed"}}},
        {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"const": "configured-route"}, "status": {"const": "passed"}}},
        {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"const": "configured-product-closure"}, "status": {"const": "passed"}}},
        {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"const": "source-version-binding"}, "status": {"const": "passed"}}},
        {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"const": "release-intent-binding"}, "status": {"const": "passed"}}}
      ],
      "items": false
    },
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage": {"enum": ["pr", "develop", "nightly", "draft", "rc", "stable", "hotfix"]},
    "status": {"const": "passed"}
  }
}
