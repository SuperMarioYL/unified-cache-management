{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/reconcile-plan.schema.json",
  "title": "UCM offline non-executing release reconciliation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_manifest_sha256", "blockers", "environment_lifecycle_plan_sha256", "environment_manifest_sha256", "environment_request_sha256", "environment_result_sha256", "inventory_sha256", "kind", "lifecycle_plan_sha256", "mode", "operations", "production_ready", "promotion_evidence_sha256", "promotion_source_lifecycle_plan_sha256", "promotion_source_manifest_sha256", "schema_version", "sha256", "simulated_environment", "source_sha", "stage", "status", "version"],
  "properties": {
    "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment_lifecycle_plan_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "environment_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "environment_request_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "environment_result_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "kind": {"const": "reconcile-plan"},
    "lifecycle_plan_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"const": "dry-run"},
    "operations": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/operation"}},
    "production_ready": {"const": false},
    "promotion_evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "promotion_source_lifecycle_plan_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "promotion_source_manifest_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "schema_version": {"const": 2},
    "sha256": {"$ref": "#/$defs/sha256"},
    "simulated_environment": {"enum": ["not-provided", "not-eligible", "unanchored-simulation", "draft-passed", "draft-failed"]},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage": {"enum": ["rc", "stable", "hotfix"]},
    "status": {"enum": ["blocked", "conflict-free-preview"]},
    "version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "kind", "name"],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "kind": {"enum": ["wheel", "image", "chart"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "executed", "identity", "target"],
      "properties": {
        "action": {"enum": ["create-preview", "skip-identical", "conflict"]},
        "executed": {"const": false},
        "identity": {"type": "string"},
        "target": {"$ref": "#/$defs/target"}
      },
      "allOf": [
        {
          "if": {"properties": {"target": {"properties": {"kind": {"const": "image"}}, "required": ["kind"]}}, "required": ["target"]},
          "then": {"properties": {"identity": {"pattern": "^sha256:[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"target": {"properties": {"kind": {"enum": ["wheel", "chart"]}}, "required": ["kind"]}}, "required": ["target"]},
          "then": {"properties": {"identity": {"pattern": "^[0-9a-f]{64}$"}}}
        }
      ]
    }
  }
}
