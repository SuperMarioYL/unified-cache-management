{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/release-command.schema.json",
  "title": "UCM read-only PR command",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "actions_write", "actor", "author_association", "authorized", "command", "kind", "mode", "operations", "reason", "schema_version", "sha256"],
  "properties": {
    "accepted": {"type": "boolean"},
    "actions_write": {"const": false},
    "actor": {"type": "string", "minLength": 1},
    "author_association": {"type": "string", "minLength": 1},
    "authorized": {"type": "boolean"},
    "command": {"enum": ["build", "status", "cancel", "unsupported"]},
    "current_source_sha": {"$ref": "#/$defs/source_sha"},
    "kind": {"const": "release-command"},
    "mode": {"const": "dry-run"},
    "observed_source_sha": {"$ref": "#/$defs/source_sha"},
    "requested_source_sha": {"$ref": "#/$defs/source_sha"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "reason": {"enum": ["authorized-build-preview", "unauthorized-build", "requested-pr-sha-mismatch", "stale-pr-sha", "read-only-status", "dry-run-no-actions-write", "unsupported-command"]},
    "schema_version": {"const": 2},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "executed"],
      "properties": {
        "action": {"enum": ["build-preview", "inspect-preview", "cancel-preview", "none"]},
        "executed": {"const": false}
      }
    }
  },
  "dependentRequired": {
    "observed_source_sha": ["current_source_sha"],
    "current_source_sha": ["observed_source_sha"]
  },
  "allOf": [
    {
      "if": {"properties": {"command": {"const": "build"}}, "required": ["command"]},
      "then": {"required": ["requested_source_sha", "observed_source_sha", "current_source_sha"]}
    }
  ]
}
