{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucm.example.invalid/schemas/cleanup-plan.schema.json",
  "title": "UCM cleanup plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "inventory_sha256", "kind", "mode", "operations", "schema_version", "sha256", "summary"],
  "properties": {
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "inventory_sha256": {"$ref": "#/$defs/file_identity"},
    "kind": {"const": "cleanup-plan"},
    "mode": {"const": "read-only"},
    "operations": {
      "type": "array",
      "minItems": 0,
      "items": {"$ref": "#/$defs/operation"}
    },
    "schema_version": {"const": 2},
    "sha256": {"$ref": "#/$defs/file_identity"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delete_preview", "skip", "total", "would_fail"],
      "properties": {
        "delete_preview": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "would_fail": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "file_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oci_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "channel", "coordinate", "executed", "identity", "kind", "object_id", "reason"],
      "properties": {
        "action": {"enum": ["delete-preview", "skip", "would-fail"]},
        "channel": {"enum": ["pr", "develop", "nightly", "draft", "rc", "stable", "hotfix"]},
        "coordinate": {"type": "string", "minLength": 1},
        "executed": {"const": false},
        "identity": {"type": "string"},
        "kind": {"enum": ["artifact", "image", "chart"]},
        "object_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["artifact", "chart"]}}, "required": ["kind"]},
          "then": {"properties": {"identity": {"$ref": "#/$defs/file_identity"}}},
          "else": {"properties": {"identity": {"$ref": "#/$defs/oci_identity"}}}
        }
      ]
    }
  }
}
