{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ucm/release/v2/retention-policy.schema.json",
  "title": "UCM retention policy lookup",
  "type": "object",
  "additionalProperties": false,
  "required": ["days", "kind", "mode", "retention_class", "schema_version"],
  "properties": {
    "days": {"enum": [7, 14, 30, null]},
    "kind": {"const": "retention-policy"},
    "mode": {"const": "dry-run"},
    "retention_class": {"enum": ["pr", "develop", "nightly", "draft", "rc", "stable", "hotfix"]},
    "schema_version": {"const": 2}
  },
  "allOf": [
    {"if": {"properties": {"retention_class": {"const": "pr"}}, "required": ["retention_class"]}, "then": {"properties": {"days": {"const": 7}}}},
    {"if": {"properties": {"retention_class": {"enum": ["develop", "nightly"]}}, "required": ["retention_class"]}, "then": {"properties": {"days": {"const": 14}}}},
    {"if": {"properties": {"retention_class": {"const": "draft"}}, "required": ["retention_class"]}, "then": {"properties": {"days": {"const": 30}}}},
    {"if": {"properties": {"retention_class": {"enum": ["rc", "stable", "hotfix"]}}, "required": ["retention_class"]}, "then": {"properties": {"days": {"const": null}}}}
  ]
}
