{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelengine-group.example/ucm/release-manifest.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registryMemberOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-member-push-by-digest"},
            "capability": {"const": "write"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging@sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-staging-tag-create"},
            "capability": {"const": "write"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging:staging-[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-authenticated-digest-read"},
            "capability": {"const": "read"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging@sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-authenticated-manifest-read"},
            "capability": {"const": "read"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging@sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-authenticated-config-blob-read"},
            "capability": {"const": "read"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging@sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-authenticated-layer-blob-read"},
            "capability": {"const": "read"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging@sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "capability", "reference"],
          "properties": {
            "type": {"const": "registry-anonymous-visibility-read"},
            "capability": {"const": "read"},
            "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/ucm-release-staging:staging-[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "registryIndexOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "capability", "reference"],
      "properties": {
        "type": {"const": "registry-index-create"},
        "capability": {"const": "write"},
        "reference": {"type": "string", "pattern": "^ghcr\\.io/supermarioyl/(?:vllm-openai:v0\\.21\\.0-ucm-0\\.5\\.0rc1-r1|vllm-ascend:v0\\.22\\.1rc1(?:-a3)?-ucm-0\\.5\\.0rc1-r1)$"}
      }
    },
    "registryCollisionModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "in_system_serialization", "fresh_prewrite_read", "exact_postwrite_readback", "external_admin_atomicity"],
      "properties": {
        "model": {"const": "observed-state-fail-closed"},
        "in_system_serialization": {"const": "repository-concurrency"},
        "fresh_prewrite_read": {"type": "boolean", "const": true},
        "exact_postwrite_readback": {"type": "boolean", "const": true},
        "external_admin_atomicity": {"const": "unavailable"}
      }
    },
    "registryLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest", "size", "blob_sha256"],
      "properties": {
        "media_type": {"enum": ["application/vnd.oci.image.layer.v1.tar", "application/vnd.oci.image.layer.v1.tar+gzip", "application/vnd.docker.image.rootfs.diff.tar.gzip"]},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1},
        "blob_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryMemberAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["io.ucm.release.build-key-sha256", "io.ucm.release.candidate-task-sha256", "io.ucm.release.family-id", "io.ucm.release.platform", "io.ucm.release.spec-id", "io.ucm.release.wheel-sha256"],
      "properties": {
        "io.ucm.release.build-key-sha256": {"$ref": "#/$defs/digest"},
        "io.ucm.release.candidate-task-sha256": {"$ref": "#/$defs/digest"},
        "io.ucm.release.family-id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]},
        "io.ucm.release.platform": {"enum": ["linux/amd64", "linux/arm64"]},
        "io.ucm.release.spec-id": {"enum": ["cuda130-amd64", "cuda130-arm64", "cann900-a2-amd64", "cann900-a2-arm64", "cann900-a3-amd64", "cann900-a3-arm64"]},
        "io.ucm.release.wheel-sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryManifestAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["io.ucm.release.recipe-sha256", "io.ucm.release.task-sha256"],
      "properties": {
        "io.ucm.release.recipe-sha256": {"$ref": "#/$defs/digest"},
        "io.ucm.release.task-sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryConfigLabels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["io.ucm.release.build-key-sha256", "io.ucm.release.task-sha256", "io.ucm.release.wheel-sha256"],
      "properties": {
        "io.ucm.release.build-key-sha256": {"$ref": "#/$defs/digest"},
        "io.ucm.release.task-sha256": {"$ref": "#/$defs/digest"},
        "io.ucm.release.wheel-sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest", "size", "annotations"],
      "properties": {
        "media_type": {"enum": ["application/vnd.oci.image.manifest.v1+json", "application/vnd.docker.distribution.manifest.v2+json"]},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1},
        "annotations": {"$ref": "#/$defs/registryManifestAnnotations"}
      }
    },
    "registryConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest", "size", "blob_sha256", "labels"],
      "properties": {
        "media_type": {"const": "application/vnd.oci.image.config.v1+json"},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1},
        "blob_sha256": {"$ref": "#/$defs/digest"},
        "labels": {"$ref": "#/$defs/registryConfigLabels"}
      }
    },
    "registryMemberRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "status", "spec_id", "profile_id", "family_id", "platform", "target_repository", "target_tag", "staging_repository", "staging_visibility", "staging_tag", "candidate_task_sha256", "publication_task_sha256", "build_key_sha256", "wheel_sha256", "member_digest", "member_size", "config_digest", "annotations", "source_sha", "image_result_sha256", "recipe_sha256", "content_identity_sha256", "manifest", "config", "layers", "readback_sha256", "visibility_evidence_sha256", "collision_model", "operations", "record_sha256"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"const": "ucm-registry-member-publication"},
        "status": {"const": "passed"},
        "spec_id": {"enum": ["cuda130-amd64", "cuda130-arm64", "cann900-a2-amd64", "cann900-a2-arm64", "cann900-a3-amd64", "cann900-a3-arm64"]},
        "profile_id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]},
        "family_id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]},
        "platform": {"enum": ["linux/amd64", "linux/arm64"]},
        "target_repository": {"enum": ["ghcr.io/supermarioyl/vllm-openai", "ghcr.io/supermarioyl/vllm-ascend"]},
        "target_tag": {"enum": ["v0.21.0-ucm-0.5.0rc1-r1", "v0.22.1rc1-ucm-0.5.0rc1-r1", "v0.22.1rc1-a3-ucm-0.5.0rc1-r1"]},
        "staging_repository": {"const": "ghcr.io/supermarioyl/ucm-release-staging"},
        "staging_visibility": {"const": "private"},
        "staging_tag": {"type": "string", "pattern": "^staging-[0-9a-f]{64}$"},
        "candidate_task_sha256": {"$ref": "#/$defs/digest"},
        "publication_task_sha256": {"$ref": "#/$defs/digest"},
        "build_key_sha256": {"$ref": "#/$defs/digest"},
        "wheel_sha256": {"$ref": "#/$defs/digest"},
        "member_digest": {"$ref": "#/$defs/digest"},
        "member_size": {"type": "integer", "minimum": 1},
        "config_digest": {"$ref": "#/$defs/digest"},
        "annotations": {"$ref": "#/$defs/registryMemberAnnotations"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image_result_sha256": {"$ref": "#/$defs/digest"},
        "recipe_sha256": {"$ref": "#/$defs/digest"},
        "content_identity_sha256": {"$ref": "#/$defs/digest"},
        "manifest": {"$ref": "#/$defs/registryManifest"},
        "config": {"$ref": "#/$defs/registryConfig"},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/registryLayer"}},
        "readback_sha256": {"$ref": "#/$defs/digest"},
        "visibility_evidence_sha256": {"$ref": "#/$defs/digest"},
        "collision_model": {"$ref": "#/$defs/registryCollisionModel"},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/registryMemberOperation"}},
        "record_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryIndexRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "status", "family_id", "target_repository", "target_tag", "index_build_key_sha256", "index_digest", "manifest_sha256", "member_digests", "authenticated_readback_sha256", "anonymous_readback_sha256", "collision_model", "operations", "record_sha256"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "kind": {"const": "ucm-registry-index-publication"},
        "status": {"const": "passed"},
        "family_id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]},
        "target_repository": {"enum": ["ghcr.io/supermarioyl/vllm-openai", "ghcr.io/supermarioyl/vllm-ascend"]},
        "target_tag": {"enum": ["v0.21.0-ucm-0.5.0rc1-r1", "v0.22.1rc1-ucm-0.5.0rc1-r1", "v0.22.1rc1-a3-ucm-0.5.0rc1-r1"]},
        "index_build_key_sha256": {"$ref": "#/$defs/digest"},
        "index_digest": {"$ref": "#/$defs/digest"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "member_digests": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "authenticated_readback_sha256": {"$ref": "#/$defs/digest"},
        "anonymous_readback_sha256": {"$ref": "#/$defs/digest"},
        "collision_model": {"$ref": "#/$defs/registryCollisionModel"},
        "operations": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/registryIndexOperation"}},
        "record_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryPublication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "candidate_task_sha256", "publication_task_sha256", "member_records", "index_records"],
          "properties": {
            "status": {"enum": ["candidate", "blocked"]},
            "candidate_task_sha256": {"$ref": "#/$defs/digest"},
            "publication_task_sha256": {"$ref": "#/$defs/digest"},
            "member_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/registryMemberRecord"}},
            "index_records": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/registryIndexRecord"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "candidate_task_sha256", "publication_task_sha256", "member_records", "index_records"],
          "properties": {
            "status": {"const": "published"},
            "candidate_task_sha256": {"$ref": "#/$defs/digest"},
            "publication_task_sha256": {"$ref": "#/$defs/digest"},
            "member_records": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "uniqueItems": true,
              "prefixItems": [
                {"$ref": "#/$defs/registryMemberRecord", "properties": {"spec_id": {"const": "cuda130-amd64"}, "profile_id": {"const": "cuda130"}, "family_id": {"const": "cuda130"}, "platform": {"const": "linux/amd64"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-openai"}, "target_tag": {"const": "v0.21.0-ucm-0.5.0rc1-r1"}, "annotations": {"properties": {"io.ucm.release.spec-id": {"const": "cuda130-amd64"}, "io.ucm.release.family-id": {"const": "cuda130"}, "io.ucm.release.platform": {"const": "linux/amd64"}}}}},
                {"$ref": "#/$defs/registryMemberRecord", "properties": {"spec_id": {"const": "cuda130-arm64"}, "profile_id": {"const": "cuda130"}, "family_id": {"const": "cuda130"}, "platform": {"const": "linux/arm64"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-openai"}, "target_tag": {"const": "v0.21.0-ucm-0.5.0rc1-r1"}, "annotations": {"properties": {"io.ucm.release.spec-id": {"const": "cuda130-arm64"}, "io.ucm.release.family-id": {"const": "cuda130"}, "io.ucm.release.platform": {"const": "linux/arm64"}}}}},
                {"$ref": "#/$defs/registryMemberRecord", "properties": {"spec_id": {"const": "cann900-a2-amd64"}, "profile_id": {"const": "cann900-a2"}, "family_id": {"const": "cann900-a2"}, "platform": {"const": "linux/amd64"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-ascend"}, "target_tag": {"const": "v0.22.1rc1-ucm-0.5.0rc1-r1"}, "annotations": {"properties": {"io.ucm.release.spec-id": {"const": "cann900-a2-amd64"}, "io.ucm.release.family-id": {"const": "cann900-a2"}, "io.ucm.release.platform": {"const": "linux/amd64"}}}}},
                {"$ref": "#/$defs/registryMemberRecord", "properties": {"spec_id": {"const": "cann900-a2-arm64"}, "profile_id": {"const": "cann900-a2"}, "family_id": {"const": "cann900-a2"}, "platform": {"const": "linux/arm64"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-ascend"}, "target_tag": {"const": "v0.22.1rc1-ucm-0.5.0rc1-r1"}, "annotations": {"properties": {"io.ucm.release.spec-id": {"const": "cann900-a2-arm64"}, "io.ucm.release.family-id": {"const": "cann900-a2"}, "io.ucm.release.platform": {"const": "linux/arm64"}}}}},
                {"$ref": "#/$defs/registryMemberRecord", "properties": {"spec_id": {"const": "cann900-a3-amd64"}, "profile_id": {"const": "cann900-a3"}, "family_id": {"const": "cann900-a3"}, "platform": {"const": "linux/amd64"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-ascend"}, "target_tag": {"const": "v0.22.1rc1-a3-ucm-0.5.0rc1-r1"}, "annotations": {"properties": {"io.ucm.release.spec-id": {"const": "cann900-a3-amd64"}, "io.ucm.release.family-id": {"const": "cann900-a3"}, "io.ucm.release.platform": {"const": "linux/amd64"}}}}},
                {"$ref": "#/$defs/registryMemberRecord", "properties": {"spec_id": {"const": "cann900-a3-arm64"}, "profile_id": {"const": "cann900-a3"}, "family_id": {"const": "cann900-a3"}, "platform": {"const": "linux/arm64"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-ascend"}, "target_tag": {"const": "v0.22.1rc1-a3-ucm-0.5.0rc1-r1"}, "annotations": {"properties": {"io.ucm.release.spec-id": {"const": "cann900-a3-arm64"}, "io.ucm.release.family-id": {"const": "cann900-a3"}, "io.ucm.release.platform": {"const": "linux/arm64"}}}}}
              ],
              "items": false
            },
            "index_records": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "prefixItems": [
                {"$ref": "#/$defs/registryIndexRecord", "properties": {"family_id": {"const": "cann900-a3"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-ascend"}, "target_tag": {"const": "v0.22.1rc1-a3-ucm-0.5.0rc1-r1"}}},
                {"$ref": "#/$defs/registryIndexRecord", "properties": {"family_id": {"const": "cann900-a2"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-ascend"}, "target_tag": {"const": "v0.22.1rc1-ucm-0.5.0rc1-r1"}}},
                {"$ref": "#/$defs/registryIndexRecord", "properties": {"family_id": {"const": "cuda130"}, "target_repository": {"const": "ghcr.io/supermarioyl/vllm-openai"}, "target_tag": {"const": "v0.21.0-ucm-0.5.0rc1-r1"}}}
              ],
              "items": false
            }
          }
        }
      ]
    },
    "externalRequiredDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "provider", "expected_mount_root", "relation", "required_at"],
      "properties": {
        "dependency": {"const": "libascend_hal.so"},
        "provider": {"const": "host-ascend-driver"},
        "expected_mount_root": {"const": "/usr/local/Ascend/driver/lib64"},
        "relation": {"const": "transitive"},
        "required_at": {"const": "device-runtime"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "ucm_version", "config_sha256", "compatibility_sha256", "declared_wheel_count", "eligible_wheel_count", "wheel_specs", "blockers", "publication", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ucm-core-release-manifest"},
    "ucm_version": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "declared_wheel_count": {"type": "integer", "minimum": 1},
    "eligible_wheel_count": {"type": "integer", "minimum": 0},
    "wheel_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id", "accelerator", "accelerator_runtime", "npu_arch_or_na", "os", "cpu_arch", "python_version", "python_abi", "wheel_version", "wheel_platform", "binary_profile_id", "validation_targets", "required_native", "forbidden_native", "allowed_dt_needed", "external_required_dependencies", "locks", "runner", "build_eligible", "blocked_reasons", "declaration_sha256"],
        "properties": {
          "spec_id": {"type": "string"},
          "accelerator": {"enum": ["cuda", "ascend"]},
          "accelerator_runtime": {"type": "string"},
          "npu_arch_or_na": {"enum": ["na", "a2", "a3"]},
          "os": {"enum": ["ubuntu-22.04", "openEuler-24.03"]},
          "cpu_arch": {"enum": ["amd64", "arm64"]},
          "python_version": {"enum": ["3.11", "3.12"]},
          "python_abi": {"enum": ["cp311", "cp312"]},
          "wheel_version": {"type": "string"},
          "wheel_platform": {"enum": ["manylinux_2_28", "linux"]},
          "binary_profile_id": {"type": "string"},
          "validation_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "required_native": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "forbidden_native": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "allowed_dt_needed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "external_required_dependencies": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/externalRequiredDependency"}},
          "locks": {"type": "array", "minItems": 2, "items": {"type": "object"}},
          "runner": {"type": "object"},
          "build_eligible": {"type": "boolean"},
          "blocked_reasons": {"type": "array", "items": {"type": "string"}},
          "declaration_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "assets"],
      "properties": {
        "target": {"const": "github-release"},
        "registry": {"$ref": "#/$defs/registryPublication"},
        "assets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "required", "status"],
            "properties": {
              "id": {"type": "string"},
              "type": {"enum": ["wheel", "helm-chart"]},
              "required": {"const": true},
              "status": {"enum": ["blocked", "candidate"]}
            }
          }
        }
      }
    },
    "status": {"enum": ["blocked", "candidate"]}
  }
}
