{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelengine-group.example/ucm/release-manifest.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registryOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "capability", "reference"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "capability": {"enum": ["read", "write"]},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "registryLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "digest", "size", "blob_sha256"],
      "properties": {
        "media_type": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1},
        "blob_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryMemberRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "status", "spec_id", "profile_id", "family_id", "platform", "target_repository", "target_tag", "staging_repository", "staging_visibility", "staging_tag", "candidate_task_sha256", "publication_task_sha256", "build_key_sha256", "wheel_sha256", "member_digest", "member_size", "config_digest", "annotations", "source_sha", "image_result_sha256", "recipe_sha256", "content_identity_sha256", "manifest", "config", "layers", "readback_sha256", "visibility_evidence_sha256", "operations", "record_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "ucm-registry-member-publication"},
        "status": {"const": "passed"},
        "spec_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "platform": {"enum": ["linux/amd64", "linux/arm64"]},
        "target_repository": {"type": "string", "minLength": 1},
        "target_tag": {"type": "string", "minLength": 1},
        "staging_repository": {"const": "ghcr.io/supermarioyl/ucm-release-staging"},
        "staging_visibility": {"const": "private"},
        "staging_tag": {"type": "string", "pattern": "^staging-[0-9a-f]{64}$"},
        "candidate_task_sha256": {"$ref": "#/$defs/digest"},
        "publication_task_sha256": {"$ref": "#/$defs/digest"},
        "build_key_sha256": {"$ref": "#/$defs/digest"},
        "wheel_sha256": {"$ref": "#/$defs/digest"},
        "member_digest": {"$ref": "#/$defs/digest"},
        "member_size": {"type": "integer", "minimum": 1},
        "config_digest": {"$ref": "#/$defs/digest"},
        "annotations": {"type": "object"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image_result_sha256": {"$ref": "#/$defs/digest"},
        "recipe_sha256": {"$ref": "#/$defs/digest"},
        "content_identity_sha256": {"$ref": "#/$defs/digest"},
        "manifest": {"type": "object"},
        "config": {"type": "object"},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/registryLayer"}},
        "readback_sha256": {"$ref": "#/$defs/digest"},
        "visibility_evidence_sha256": {"$ref": "#/$defs/digest"},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/registryOperation"}},
        "record_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryIndexRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "status", "family_id", "target_repository", "target_tag", "index_build_key_sha256", "index_digest", "manifest_sha256", "member_digests", "authenticated_readback_sha256", "anonymous_readback_sha256", "operations", "record_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "ucm-registry-index-publication"},
        "status": {"const": "passed"},
        "family_id": {"type": "string", "minLength": 1},
        "target_repository": {"type": "string", "minLength": 1},
        "target_tag": {"type": "string", "minLength": 1},
        "index_build_key_sha256": {"$ref": "#/$defs/digest"},
        "index_digest": {"$ref": "#/$defs/digest"},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "member_digests": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "authenticated_readback_sha256": {"$ref": "#/$defs/digest"},
        "anonymous_readback_sha256": {"$ref": "#/$defs/digest"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/registryOperation"}},
        "record_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "registryPublication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "candidate_task_sha256", "publication_task_sha256", "member_records", "index_records"],
          "properties": {
            "status": {"enum": ["candidate", "blocked"]},
            "candidate_task_sha256": {"$ref": "#/$defs/digest"},
            "publication_task_sha256": {"$ref": "#/$defs/digest"},
            "member_records": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/registryMemberRecord"}},
            "index_records": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/registryIndexRecord"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "candidate_task_sha256", "publication_task_sha256", "member_records", "index_records"],
          "properties": {
            "status": {"const": "published"},
            "candidate_task_sha256": {"$ref": "#/$defs/digest"},
            "publication_task_sha256": {"$ref": "#/$defs/digest"},
            "member_records": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/registryMemberRecord"}},
            "index_records": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/registryIndexRecord"}}
          }
        }
      ]
    },
    "externalRequiredDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency", "provider", "expected_mount_root", "relation", "required_at"],
      "properties": {
        "dependency": {"const": "libascend_hal.so"},
        "provider": {"const": "host-ascend-driver"},
        "expected_mount_root": {"const": "/usr/local/Ascend/driver/lib64"},
        "relation": {"const": "transitive"},
        "required_at": {"const": "device-runtime"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "ucm_version", "config_sha256", "compatibility_sha256", "declared_wheel_count", "eligible_wheel_count", "wheel_specs", "blockers", "publication", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ucm-core-release-manifest"},
    "ucm_version": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "declared_wheel_count": {"type": "integer", "minimum": 1},
    "eligible_wheel_count": {"type": "integer", "minimum": 0},
    "wheel_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec_id", "accelerator", "accelerator_runtime", "npu_arch_or_na", "os", "cpu_arch", "python_version", "python_abi", "wheel_version", "wheel_platform", "binary_profile_id", "validation_targets", "required_native", "forbidden_native", "allowed_dt_needed", "external_required_dependencies", "locks", "runner", "build_eligible", "blocked_reasons", "declaration_sha256"],
        "properties": {
          "spec_id": {"type": "string"},
          "accelerator": {"enum": ["cuda", "ascend"]},
          "accelerator_runtime": {"type": "string"},
          "npu_arch_or_na": {"enum": ["na", "a2", "a3"]},
          "os": {"enum": ["ubuntu-22.04", "openEuler-24.03"]},
          "cpu_arch": {"enum": ["amd64", "arm64"]},
          "python_version": {"enum": ["3.11", "3.12"]},
          "python_abi": {"enum": ["cp311", "cp312"]},
          "wheel_version": {"type": "string"},
          "wheel_platform": {"enum": ["manylinux_2_28", "linux"]},
          "binary_profile_id": {"type": "string"},
          "validation_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "required_native": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "forbidden_native": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "allowed_dt_needed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "external_required_dependencies": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/externalRequiredDependency"}},
          "locks": {"type": "array", "minItems": 2, "items": {"type": "object"}},
          "runner": {"type": "object"},
          "build_eligible": {"type": "boolean"},
          "blocked_reasons": {"type": "array", "items": {"type": "string"}},
          "declaration_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "assets"],
      "properties": {
        "target": {"const": "github-release"},
        "registry": {"$ref": "#/$defs/registryPublication"},
        "assets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "required", "status"],
            "properties": {
              "id": {"type": "string"},
              "type": {"enum": ["wheel", "helm-chart"]},
              "required": {"const": true},
              "status": {"enum": ["blocked", "candidate"]}
            }
          }
        }
      }
    },
    "status": {"enum": ["blocked", "candidate"]}
  }
}
