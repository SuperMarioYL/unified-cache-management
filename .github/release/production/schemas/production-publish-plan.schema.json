{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unified-cache-management/schemas/production-publish-plan.schema.json",
  "title": "UCM production publish plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "repository", "repository_id", "stage", "tag_name", "source_sha", "candidate_sha256", "inventory_sha256", "publishable", "items", "operations", "blockers", "sha256"],
  "properties": {
    "kind": {"const": "ucm-production-publish-plan"},
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "repository_id": {"type": "integer", "minimum": 1},
    "stage": {"enum": ["draft", "rc", "stable", "hotfix"]},
    "tag_name": {"type": "string", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "publishable": {"type": "boolean"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "operations": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
