{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unified-cache-management/schemas/production-tag-intent.schema.json",
  "title": "UCM production Tag intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "stage", "tag_name", "version", "wheel_version", "chart_version", "image_tag", "release_branch", "draft_number", "rc_number", "sha256"],
  "properties": {
    "kind": {"const": "ucm-production-tag-intent"},
    "schema_version": {"const": 1},
    "stage": {"enum": ["draft", "rc", "stable", "hotfix"]},
    "tag_name": {"type": "string", "pattern": "^(?:draft/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-[1-9][0-9]*|v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:rc[1-9][0-9]*)?)$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "wheel_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:(?:rc|\\.dev)[1-9][0-9]*)?$"},
    "chart_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:draft|rc)\\.[1-9][0-9]*)?$"},
    "image_tag": {"type": "string", "pattern": "^(?:draft-v|v)[A-Za-z0-9.-]+$"},
    "release_branch": {"type": "string", "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+-release|hotfix/[0-9]+\\.[0-9]+\\.[0-9]+)$"},
    "draft_number": {"type": ["integer", "null"], "minimum": 1},
    "rc_number": {"type": ["integer", "null"], "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "draft"}}, "required": ["stage"]}, "then": {"properties": {"draft_number": {"type": "integer", "minimum": 1}, "rc_number": {"const": null}}}},
    {"if": {"properties": {"stage": {"const": "rc"}}, "required": ["stage"]}, "then": {"properties": {"draft_number": {"const": null}, "rc_number": {"type": "integer", "minimum": 1}}}},
    {"if": {"properties": {"stage": {"enum": ["stable", "hotfix"]}}, "required": ["stage"]}, "then": {"properties": {"draft_number": {"const": null}, "rc_number": {"const": null}}}}
  ]
}
