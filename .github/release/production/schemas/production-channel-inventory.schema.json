{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unified-cache-management/schemas/production-channel-inventory.schema.json",
  "title": "UCM production channel inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "repository", "repository_id", "objects", "sha256"],
  "properties": {
    "kind": {"const": "ucm-production-channel-inventory"},
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"},
    "repository_id": {"type": "integer", "minimum": 1},
    "objects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/object"}},
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "stage", "state", "identity"],
      "properties": {
        "coordinate": {"type": "string", "minLength": 1},
        "stage": {"enum": ["draft", "rc", "stable", "hotfix"]},
        "state": {"enum": ["complete", "partial"]},
        "identity": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
