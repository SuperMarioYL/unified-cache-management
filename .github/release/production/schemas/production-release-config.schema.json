{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unified-cache-management/schemas/production-release-config.schema.json",
  "title": "UCM production release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "release_line", "base_version", "release_branch", "environment", "products", "build_profiles", "channels", "retention_days", "external_channels", "toolchain"],
  "properties": {
    "kind": {"const": "ucm-production-release-config"},
    "schema_version": {"const": 1},
    "release_line": {"const": "0.6"},
    "base_version": {"const": "0.6.0"},
    "release_branch": {"const": "0.6.0-release"},
    "environment": {"const": "release-production"},
    "products": {"type": "object", "additionalProperties": false, "required": ["wheels", "images", "chart"], "properties": {"wheels": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["profile_id", "distribution", "import_name"], "properties": {"profile_id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]}, "distribution": {"enum": ["uc-manager-cuda130", "uc-manager-cann900-a2-mc039", "uc-manager-cann900-a3-mc039"]}, "import_name": {"const": "ucm"}}}}, "images": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["profile_id", "basename", "draft_basename"], "properties": {"profile_id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]}, "basename": {"enum": ["ucm-cuda", "ucm-cann-a2", "ucm-cann-a3"]}, "draft_basename": {"enum": ["ucm-cuda-private", "ucm-cann-a2-private", "ucm-cann-a3-private"]}}}}, "chart": {"type": "object", "additionalProperties": false, "required": ["name", "source", "repository_basename"], "properties": {"name": {"const": "unified-cache-pd"}, "source": {"const": "charts/ucm"}, "repository_basename": {"const": "charts/unified-cache-pd"}}}}},
    "build_profiles": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/profile"}},
    "channels": {"type": "object", "additionalProperties": false, "required": ["draft", "rc", "stable", "hotfix"], "properties": {"draft": {"$ref": "#/$defs/channel"}, "rc": {"$ref": "#/$defs/channel"}, "stable": {"$ref": "#/$defs/channel"}, "hotfix": {"$ref": "#/$defs/channel"}}},
    "retention_days": {"type": "object", "additionalProperties": false, "required": ["candidate", "evidence"], "properties": {"candidate": {"type": "integer", "minimum": 1}, "evidence": {"type": "integer", "minimum": 1}}},
    "external_channels": {"type": "object", "additionalProperties": false, "required": ["docker_hub", "pypi"], "properties": {"docker_hub": {"oneOf": [{"const": false}, {"$ref": "#/$defs/dockerHub"}]}, "pypi": {"oneOf": [{"const": false}, {"$ref": "#/$defs/pypi"}]}}},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["legacy_release_config_sha256", "runtime_requirements", "python_build", "pyyaml", "cmake", "wrapt"], "properties": {"legacy_release_config_sha256": {"$ref": "#/$defs/sha256"}, "runtime_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*==[^*=\\s]+$"}}, "python_build": {"type": "object"}, "pyyaml": {"type": "object"}, "cmake": {"type": "object"}, "wrapt": {"type": "object"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ociDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lock": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "index_digest", "manifest_digest", "config_digest"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}, "index_digest": {"$ref": "#/$defs/ociDigest"}, "manifest_digest": {"$ref": "#/$defs/ociDigest"}, "config_digest": {"$ref": "#/$defs/ociDigest"}}},
    "archLocks": {"type": "object", "additionalProperties": false, "required": ["amd64", "arm64"], "properties": {"amd64": {"$ref": "#/$defs/lock"}, "arm64": {"$ref": "#/$defs/lock"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "distribution", "build_platform", "cpu_arch", "python_version", "python_abi", "wheel_platform", "builders", "runtime"], "properties": {"id": {"enum": ["cuda130", "cann900-a2", "cann900-a3"]}, "distribution": {"enum": ["uc-manager-cuda130", "uc-manager-cann900-a2-mc039", "uc-manager-cann900-a3-mc039"]}, "build_platform": {"enum": ["cuda", "ascend", "ascend-a3"]}, "cpu_arch": {"const": ["amd64", "arm64"]}, "python_version": {"const": "3.12"}, "python_abi": {"const": "cp312"}, "wheel_platform": {"enum": ["manylinux_2_28", "linux"]}, "builders": {"$ref": "#/$defs/archLocks"}, "runtime": {"$ref": "#/$defs/archLocks"}}},
    "channel": {"type": "object", "additionalProperties": false, "required": ["github_release", "image_visibility", "publish_chart", "environment_test"], "properties": {"github_release": {"enum": ["draft", "prerelease", "release"]}, "image_visibility": {"enum": ["private", "public"]}, "publish_chart": {"type": "boolean"}, "environment_test": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["passed", "waived-for-preview"]}}}},
    "pypi": {"type": "object", "additionalProperties": false, "required": ["repository", "trusted_publisher"], "properties": {"repository": {"const": "https://upload.pypi.org/legacy/"}, "trusted_publisher": {"const": "github-oidc"}}},
    "dockerHub": {"type": "object", "additionalProperties": false, "required": ["namespace", "repositories"], "properties": {"namespace": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}, "repositories": {"type": "object", "additionalProperties": false, "required": ["cuda130", "cann900-a2", "cann900-a3"], "properties": {"cuda130": {"const": "ucm-cuda"}, "cann900-a2": {"const": "ucm-cann-a2"}, "cann900-a3": {"const": "ucm-cann-a3"}}}}}
  }
}
