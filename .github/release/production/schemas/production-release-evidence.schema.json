{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unified-cache-management/schemas/production-release-evidence.schema.json",
  "title": "UCM production release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "status", "repository", "repository_id", "default_branch", "control_sha", "source_sha", "tag_name", "tag_object_sha", "run_id", "run_attempt", "candidate_sha256", "identity", "candidate", "environment", "channels", "operations", "blockers", "sha256"],
  "properties": {
    "kind": {"const": "ucm-production-release-evidence"},
    "schema_version": {"const": 1},
    "status": {"enum": ["complete", "partial-publication", "blocked"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"},
    "repository_id": {"type": "integer", "minimum": 1},
    "default_branch": {"type": "string", "minLength": 1},
    "control_sha": {"$ref": "#/$defs/commit"},
    "source_sha": {"$ref": "#/$defs/commit"},
    "tag_name": {"type": "string", "minLength": 1},
    "tag_object_sha": {"$ref": "#/$defs/commit"},
    "run_id": {"type": "integer", "minimum": 1},
    "run_attempt": {"type": "integer", "minimum": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "identity": {"type": "object"},
    "candidate": {"type": "object"},
    "environment": {"type": "object"},
    "channels": {"type": "array", "items": {"type": "object"}},
    "operations": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
